# ZegoCloud
# Firebase (configuré via src/firebase/firebase.ts)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=

# URL publique du serveur API pour les emails et la clôture des salles vides
VITE_API_BASE_URL=

# Identifiants Firebase Admin à définir uniquement sur le serveur API
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative : chemin vers le fichier de compte de service
FIREBASE_SERVICE_ACCOUNT_PATH=

# Backend (optionnel, si tu utilises le serveur local pour les emails/tokens)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=ton_email@gmail.com
MAIL_PASSWORD=ton_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=ton_email@gmail.com
